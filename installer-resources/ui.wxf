<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Fragment>
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR"></Property>
    <Property Id="JP_INSTALL_DESKTOP_SHORTCUT" Value="1"></Property>
    <Property Id="DEPENDENCIES_CHECKED" Value="1"></Property>
    
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Stash" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[INSTALLDIR]Stash.exe" />
    <CustomAction Id="LaunchApplication" BinaryKey="WixCA" DllEntry="WixShellExec" Impersonate="yes" />
    
    <UI Id="JpUI">
      <UIRef Id="WixUI_InstallDir"></UIRef>
      <DialogRef Id="InstallDirNotEmptyDlg"></DialogRef>
      
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="6">NOT Installed</Publish>
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="6">NOT Installed</Publish>
      
      <!-- Force navigation from InstallDirDlg to CustomOptionsDlg -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="CustomOptionsDlg" Order="3">1</Publish>
      <Publish Dialog="CustomOptionsDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" Order="6">NOT Installed</Publish>
      
      <Publish Dialog="CustomOptionsDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="6">NOT Installed</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="CustomOptionsDlg" Order="6">NOT Installed</Publish>
      
      <!-- Launch application on exit -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>

      <Dialog Id="CustomOptionsDlg" Width="370" Height="270" Title="[ProductName] Setup Options">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Setup Options" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Select additional shortcut and dependency options." />

        <!-- Checkbox for Desktop Shortcut -->
        <Control Id="DesktopShortcutCheckBox" Type="CheckBox" X="25" Y="70" Width="290" Height="17" Property="JP_INSTALL_DESKTOP_SHORTCUT" CheckBoxValue="1" Text="Create a shortcut on the Desktop" />

        <!-- Checkbox for Dependencies -->
        <Control Id="DependenciesCheckBox" Type="CheckBox" X="25" Y="110" Width="290" Height="17" Property="DEPENDENCIES_CHECKED" CheckBoxValue="1" Text="Install dependencies ('yt-dlp' &amp; 'ffmpeg') automatically within the application" />
        <Control Id="DependenciesText" Type="Text" X="45" Y="130" Width="280" Height="45" Text="Stash will download and install these dependencies in the background during first startup. Alternatively, you can pre-download them with the installer resources." />

        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg"><![CDATA[DEPENDENCIES_CHECKED = "1" OR PROCEED_WITHOUT_DEPS = "1"]]></Publish>
          <Publish Event="SpawnDialog" Value="DependencyWarningDlg"><![CDATA[DEPENDENCIES_CHECKED <> "1" AND (NOT PROCEED_WITHOUT_DEPS OR PROCEED_WITHOUT_DEPS <> "1")]]></Publish>
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="InstallDirDlg">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>

      <Dialog Id="DependencyWarningDlg" Width="260" Height="85" Title="Dependency Warning">
        <Control Id="Text" Type="Text" X="15" Y="15" Width="230" Height="30" Text="Warning: Stash requires 'yt-dlp' and 'ffmpeg' to function. Running without them will cause downloads to fail. Are you sure you want to proceed?" />
        <Control Id="Yes" Type="PushButton" X="70" Y="57" Width="56" Height="17" Default="yes" Text="Yes">
          <Publish Property="PROCEED_WITHOUT_DEPS" Value="1">1</Publish>
          <Publish Event="EndDialog" Value="Return">1</Publish>
          <Publish Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
        </Control>
        <Control Id="No" Type="PushButton" X="134" Y="57" Width="56" Height="17" Cancel="yes" Text="No">
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>
      </Dialog>
    </UI>
  </Fragment>
</Wix>
