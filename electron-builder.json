{
  "appId": "com.eurtlabs.stash",
  "productName": "Stash",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist",
    "dist-electron",
    "app-resources/**/*"
  ],
  "extraResources": [
    {
      "from": "app-resources/windows",
      "to": "bin",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "target": ["nsis", "msi"],
    "icon": "app-resources/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
