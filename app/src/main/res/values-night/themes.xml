<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark/Night theme -->
    <style name="Theme.Stash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorPrimaryVariant">@color/accent_primary_dark</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/accent_primary_light</item>
        <item name="colorSecondaryVariant">@color/accent_primary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- In Dark mode, set status bar icons to light -->
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>
</resources>